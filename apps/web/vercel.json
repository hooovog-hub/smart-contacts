{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/terms",
      "destination": "/api/legal?doc=terms"
    },
    {
      "source": "/privacy",
      "destination": "/api/legal?doc=privacy"
    },
    {
      "source": "/i/:code",
      "destination": "/api/invite?code=:code"
    },
    {
      "source": "/r/:code",
      "destination": "/api/room?code=:code"
    },
    {
      "source": "/:handle/vcard",
      "destination": "/api/vcard?handle=:handle"
    },
    {
      "source": "/:handle((?!api|favicon\\.ico|index).+)",
      "destination": "/api/profile?handle=:handle"
    }
  ]
}
