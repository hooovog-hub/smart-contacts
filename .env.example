# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # только сервер

# Claude API — ТОЛЬКО в секретах Supabase Edge Functions
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Apple Wallet (сервер, apps/web) — base64 сертификатов, не файлы в репо
WALLET_PASS_TYPE_ID=pass.am.smartcontacts.card
WALLET_TEAM_ID=
WALLET_SIGNER_CERT_B64=
WALLET_SIGNER_KEY_B64=
WALLET_SIGNER_KEY_PASSPHRASE=
WALLET_WWDR_CERT_B64=

# Публичный адрес веб-профилей
NEXT_PUBLIC_SITE_URL=https://smartcontacts.app
